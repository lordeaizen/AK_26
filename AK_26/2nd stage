/* Stage 2: Glitched Workshop -- participant frontend.
   Renders server-assigned configs. No puzzle logic beyond rendering. */
   (function () {
	"use strict"

	const API = "/api/stage2"
	const root = document.getElementById("stage2")

	const state = {
		blockNumber: 0,
		config: null,
		placementSequence: [],
		previousSequence: null,
		blockStartedAt: 0,
		lastFailureAt: null,
		awaitingFirstInputAfterFailure: false,
		clueRequestedThisAttempt: false,
		clueCostThisAttempt: 0,
		pointsBalance: null,
		breakTimer: null,
	}

	const UI_STATES = ["idle", "attempt_registered", "hint_revealed", "break_active", "block_transition"]
	function setUiState(name) {
		if (!UI_STATES.includes(name)) throw new Error("Unknown UI state: " + name)
		root.dataset.wsState = name
	}

	async function post(path, body) {
		const res = await fetch(API + path, {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			credentials: "same-origin",
			body: JSON.stringify(body || {}),
		})
		return res.json()
	}

	/* ---- Screen 1 ---- */
	function showIntro() {
		showScreen("workshop_intro")
		document.getElementById("ws-start").onclick = () => showFrustration("pre")
	}

	/* ---- Screens 2 and 6 ---- */
	function showFrustration(timing) {
		showScreen("frustration_" + timing)
		const container = document.getElementById("ws-frustration-" + timing)
		container.querySelectorAll("button[data-value]").forEach((btn) => {
			btn.onclick = async () => {
				await post("/frustration", {
					timing,
					value: Number(btn.dataset.value),
					recorded_at: new Date().toISOString(), // timestamped event
				})
				if (timing === "pre") loadBlock(1)
				else completeStage()
			}
		})
	}

	/* ---- Screens 3 to 5 ---- */
	async function loadBlock(n) {
		setUiState("block_transition")
		document.getElementById("ws-transition-text").textContent = "Loading next component…"
		showScreen("assembly")

		const res = await fetch(`${API}/block/${n}`, { credentials: "same-origin" })
		const config = await res.json()

		state.blockNumber = n
		state.config = config
		state.previousSequence = null
		state.placementSequence = []
		state.blockStartedAt = Date.now()

		document.getElementById("ws-stage-label").textContent = "Stage 2 of 8"
		renderAssembly(config)
		setUiState("idle")
	}

	function renderAssembly(config) {
		const slots = document.getElementById("ws-slots")
		const parts = document.getElementById("ws-parts")
		const rules = document.getElementById("ws-constraints")

		slots.innerHTML = config.slots
			.map((s) => `<div class="ws-slot" data-slot="${s.slot_id}"><span>${s.label}</span></div>`)
			.join("")
		parts.innerHTML = config.parts
			.map((p) => `<button class="ws-part" data-part="${p.part_id}">${p.label}</button>`)
			.join("")
		rules.innerHTML = config.constraints.map((c) => `<li>${c.text}</li>`).join("")

		document.getElementById("ws-hint-cost").textContent = `Hint (−${config.clue_cost})`
		document.getElementById("ws-hint-text").textContent = ""

		let selectedPart = null
		parts.querySelectorAll(".ws-part").forEach((btn) => {
			btn.onclick = () => {
				noteInteraction()
				selectedPart = btn.dataset.part
				parts.querySelectorAll(".ws-part").forEach((b) => b.classList.remove("ws-selected"))
				btn.classList.add("ws-selected")
			}
		})
		slots.querySelectorAll(".ws-slot").forEach((slotEl) => {
			slotEl.onclick = () => {
				if (!selectedPart) return
				noteInteraction()
				const slotId = slotEl.dataset.slot
				state.placementSequence = state.placementSequence.filter((p) => p.slot_id !== slotId)
				state.placementSequence.push({ slot_id: slotId, part_id: selectedPart })
				slotEl.dataset.filled = selectedPart
				slotEl.querySelector("span").textContent =
					config.parts.find((p) => p.part_id === selectedPart).label
				selectedPart = null
			}
		})
	}

	// Reaction-time-after-failure capture.
	function noteInteraction() {
		if (state.awaitingFirstInputAfterFailure && state.lastFailureAt) {
			state.reactionAfterFailureMs = Date.now() - state.lastFailureAt
			state.awaitingFirstInputAfterFailure = false
		}
	}

	/* ---- Toolbar actions ---- */
	function wireToolbar() {
		document.getElementById("ws-btn-repeat").onclick = () => submitAttempt()
		document.getElementById("ws-btn-change").onclick = () => {
			// Strategy change is inferred server-side from the placement sequence,
			// not asserted by the button. This only clears the board.
			state.previousSequence = state.placementSequence.slice()
			state.placementSequence = []
			renderAssembly(state.config)
			setUiState("idle")
			note("Board cleared. Try a different approach.")
		}
		document.getElementById("ws-btn-hint").onclick = requestClue
		document.getElementById("ws-btn-break").onclick = takeBreak
		document.getElementById("ws-btn-skip").onclick = () => endBlock("skipped")
		document.getElementById("ws-btn-withdraw").onclick = () => endBlock("ended_session")
	}

	function note(text) {
		document.getElementById("ws-action-note").textContent = text || ""
	}

	async function submitAttempt() {
		const payload = {
			block_number: state.blockNumber,
			placement_sequence: state.placementSequence,
			previous_sequence: state.previousSequence,
			time_spent_ms: Date.now() - state.blockStartedAt,
			reaction_time_after_prior_failure_ms: state.reactionAfterFailureMs || null,
			clue_requested: state.clueRequestedThisAttempt,
			clue_cost: state.clueCostThisAttempt,
		}

		// Deliberate friction for block 3 comes from the server-supplied delay.
		const delay = state.config.feedback_delay_ms || 0
		setUiState("attempt_registered")
		const result = await post("/attempt", payload)
		if (delay) await new Promise((r) => setTimeout(r, delay))

		state.previousSequence = state.placementSequence.slice()
		state.reactionAfterFailureMs = null
		state.clueRequestedThisAttempt = false
		state.clueCostThisAttempt = 0

		if (result.block_state === "complete") return advanceBlock()

		state.lastFailureAt = Date.now()
		state.awaitingFirstInputAfterFailure = true
		setTimeout(() => setUiState("idle"), 420)
	}

	async function requestClue() {
		const result = await post("/clue", { block_number: state.blockNumber })
		if (result.ok === false) {
			// Never disabled without explanation.
			note(result.reason)
			return
		}
		state.clueRequestedThisAttempt = true
		state.clueCostThisAttempt = result.clue_cost
		state.pointsBalance = result.points_balance
		document.getElementById("ws-hint-text").textContent = result.clue.text
		const slotEl = document.querySelector(`.ws-slot[data-slot="${result.clue.slot_id}"]`)
		if (slotEl) slotEl.classList.add("ws-hinted")
		setUiState("hint_revealed")
		note("")
	}

	async function takeBreak() {
		const result = await post("/action", {
			action: "break_taken",
			block_number: state.blockNumber,
			time_spent_ms: Date.now() - state.blockStartedAt,
		})
		let remaining = Math.ceil((result.break_duration_ms || 60000) / 1000)
		setUiState("break_active")
		const label = document.getElementById("ws-break-countdown")
		label.textContent = remaining + "s"
		state.breakTimer = setInterval(() => {
			remaining--
			label.textContent = remaining + "s"
			if (remaining <= 0) {
				clearInterval(state.breakTimer)
				setUiState("idle") // fixed length. No resume-whenever control.
			}
		}, 1000)
	}

	async function endBlock(action) {
		await post("/action", {
			action,
			block_number: state.blockNumber,
			time_spent_ms: Date.now() - state.blockStartedAt,
		})
		if (action === "ended_session") return showFrustration("post")
		advanceBlock()
	}

	function advanceBlock() {
		if (state.blockNumber < 3) return loadBlock(state.blockNumber + 1)
		showFrustration("post")
	}

	/* ---- Screen 7 ---- */
	async function completeStage() {
		showScreen("workshop_complete")
		const result = await post("/complete", {})
		// Only stage_complete and next_stage arrive here. Nothing is displayed.
		setTimeout(() => {
			window.dispatchEvent(new CustomEvent("stage:advance", { detail: { next: result.next_stage } }))
		}, 3000)
	}

	function showScreen(id) {
		root.querySelectorAll("[data-screen]").forEach((el) => {
			el.hidden = el.dataset.screen !== id
		})
	}

	window.Stage2 = {
		start() {
			wireToolbar()
			showIntro()
		},
	}
})()