"use strict"

const crypto = require("crypto")

/**
 * Reactor-component assembly puzzle.
 *
 * A puzzle is: N parts, N slots, and a set of constraints. A valid assembly is
 * a bijection part -> slot satisfying every constraint. Difficulty is raised by
 * part count, decoy parts, constraint density, label reliability and feedback
 * delay -- never by removing the solution.
 */

const BLOCK_TIERS = {
	1: {
		tier: "normal",
		parts: 5,
		decoys: 0,
		constraintDensity: 0.25,
		misleadingLabels: false,
		feedbackDelayMs: 0,
		clueCost: 5,
	},
	2: {
		tier: "difficult",
		parts: 7,
		decoys: 2,
		constraintDensity: 0.45,
		misleadingLabels: false,
		feedbackDelayMs: 250,
		clueCost: 8,
	},
	3: {
		tier: "frustrating",
		parts: 8,
		decoys: 3,
		constraintDensity: 0.6,
		// Deliberate friction. Labels may mislead, but the underlying
		// constraint set is still satisfiable and the clue ladder can always
		// recover the true mapping.
		misleadingLabels: true,
		feedbackDelayMs: 700,
		clueCost: 10,
	},
}

const PART_NAMES = [
	"Coupling ring", "Flux plate", "Damper rod", "Seal collar", "Vane housing",
	"Bias spool", "Lattice clip", "Thermal shim", "Guide pin", "Anchor brace",
	"Relay yoke",
]

function rng(seed) {
	let h = crypto.createHash("sha256").update(String(seed)).digest()
	let i = 0
	return function next() {
		if (i >= h.length - 4) {
			h = crypto.createHash("sha256").update(h).digest()
			i = 0
		}
		const v = h.readUInt32BE(i)
		i += 4
		return v / 0xffffffff
	}
}

function shuffle(arr, rand) {
	const a = arr.slice()
	for (let i = a.length - 1; i > 0; i--) {
		const j = Math.floor(rand() * (i + 1))
		;[a[i], a[j]] = [a[j], a[i]]
	}
	return a
}

/**
 * Backtracking solver. Returns the first valid full assignment, or null.
 * Used to *guarantee* solvability before a config is ever handed out.
 */
function solve(parts, slots, constraints) {
	const assignment = {} // slotId -> partId
	const used = new Set()

	function satisfied(partial) {
		return constraints.every((c) => c.check(partial, true))
	}
	function fullySatisfied(partial) {
		return constraints.every((c) => c.check(partial, false))
	}

	function step(slotIndex) {
		if (slotIndex === slots.length) {
			return fullySatisfied(assignment) ? { ...assignment } : null
		}
		const slot = slots[slotIndex]
		for (const part of parts) {
			if (used.has(part.part_id)) continue
			assignment[slot.slot_id] = part.part_id
			used.add(part.part_id)
			if (satisfied(assignment)) {
				const result = step(slotIndex + 1)
				if (result) return result
			}
			used.delete(part.part_id)
			delete assignment[slot.slot_id]
		}
		return null
	}

	return step(0)
}

function buildConstraints(slots, truth, density, rand) {
	const constraints = []
	const slotIds = slots.map((s) => s.slot_id)

	// Ordering constraints derived from the known-true mapping, so the truth
	// always satisfies them. Density controls how many are exposed.
	for (let i = 0; i < slotIds.length - 1; i++) {
		if (rand() > density) continue
		const a = slotIds[i]
		const b = slotIds[i + 1]
		constraints.push({
			id: `order_${a}_${b}`,
			text: `${a} must be fitted before ${b}.`,
			check: (partial) => {
				const ai = partial[a] !== undefined
				const bi = partial[b] !== undefined
				return !bi || ai
			},
		})
	}

	// Exclusion constraints: a specific part may never occupy a specific slot.
	// Generated only against pairs the truth does not use.
	for (const slot of slots) {
		if (rand() > density) continue
		const forbidden = Object.entries(truth).find(([sid]) => sid !== slot.slot_id)
		if (!forbidden) continue
		const forbiddenPart = forbidden[1]
		if (truth[slot.slot_id] === forbiddenPart) continue
		constraints.push({
			id: `exclude_${slot.slot_id}_${forbiddenPart}`,
			text: `${forbiddenPart} does not seat in ${slot.slot_id}.`,
			check: (partial) => partial[slot.slot_id] !== forbiddenPart,
		})
	}

	return constraints
}

/**
 * Generate a puzzle for a block. Returns { config, secret }.
 * `config` is participant-safe. `secret` never leaves the server.
 * Throws if a solvable configuration cannot be produced -- we would rather fail
 * loudly than serve an impossible block.
 */
function generatePuzzle(blockNumber, seed) {
	const spec = BLOCK_TIERS[blockNumber]
	if (!spec) throw new Error(`Unknown block_number: ${blockNumber}`)

	for (let attempt = 0; attempt < 50; attempt++) {
		const rand = rng(`${seed}:${blockNumber}:${attempt}`)
		const names = shuffle(PART_NAMES, rand)

		const realParts = Array.from({ length: spec.parts }, (_, i) => ({
			part_id: `p${i + 1}`,
			label: names[i],
			decoy: false,
		}))
		const decoyParts = Array.from({ length: spec.decoys }, (_, i) => ({
			part_id: `d${i + 1}`,
			label: names[spec.parts + i] || `Spare unit ${i + 1}`,
			decoy: true,
		}))
		const slots = Array.from({ length: spec.parts }, (_, i) => ({
			slot_id: `s${i + 1}`,
			label: `Mount ${i + 1}`,
		}))

		// Known-true mapping first, then constraints derived from it.
		const shuffledReal = shuffle(realParts, rand)
		const truth = {}
		slots.forEach((slot, i) => {
			truth[slot.slot_id] = shuffledReal[i].part_id
		})

		const constraints = buildConstraints(slots, truth, spec.constraintDensity, rand)
		const allParts = shuffle(realParts.concat(decoyParts), rand)

		// GUARANTEED-SOLVABLE GATE. Never skip this.
		const solution = solve(allParts, slots, constraints)
		if (!solution) continue

		// Misleading labels are cosmetic only. The constraint text stays truthful
		// and the clue ladder resolves to the real mapping.
		const displayParts = allParts.map((p) => ({
			part_id: p.part_id,
			label: spec.misleadingLabels && rand() < 0.4
				? `${p.label} (rev. B)`
				: p.label,
		}))

		const config = {
			block_number: blockNumber,
			tier: spec.tier,
			parts: displayParts,
			slots,
			constraints: constraints.map((c) => ({ id: c.id, text: c.text })),
			clue_cost: spec.clueCost,
			feedback_delay_ms: spec.feedbackDelayMs,
		}

		const secret = {
			solution,
			clue_ladder: Object.entries(solution).map(([slotId, partId], i) => ({
				index: i,
				slot_id: slotId,
				part_id: partId,
				// Neutral, non-judgmental phrasing only.
				text: `${slotId} accepts the part currently listed as "${
					displayParts.find((p) => p.part_id === partId).label
				}".`,
			})),
		}

		return { config, secret }
	}

	throw new Error(
		`Could not generate a solvable puzzle for block ${blockNumber}. Refusing to serve an unsolvable block.`
	)
}

/** Validate a submitted assembly against the stored solution. */
function evaluateAttempt(secret, placements) {
	const solution = secret.solution
	let errors = 0
	for (const [slotId, partId] of Object.entries(solution)) {
		if (placements[slotId] !== partId) errors++
	}
	return { solved: errors === 0, errors_count: errors }
}

/** Assert solvability of an already-generated config. Used by tests. */
function isSolvable(config) {
	const constraints = config.constraints.map((c) => rebuildConstraint(c, config))
	return Boolean(solve(config.parts, config.slots, constraints))
}

function rebuildConstraint(c, config) {
	if (c.id.startsWith("order_")) {
		const [, a, b] = c.id.split("_")
		return { id: c.id, check: (partial) => partial[b] === undefined || partial[a] !== undefined }
	}
	const parts = c.id.split("_")
	const slotId = parts[1]
	const partId = parts.slice(2).join("_")
	return { id: c.id, check: (partial) => partial[slotId] !== partId }
}

module.exports = {
	BLOCK_TIERS,
	generatePuzzle,
	evaluateAttempt,
	isSolvable,
	solve,
}
"use strict"

const crypto = require("crypto")

/**
 * A method signature identifies *how* a participant approached the assembly,
 * so repeating the same method can be distinguished from changing strategy.
 * Signature = hash of the ordered placement sequence (slot <- part).
 */
function computeMethodSignature(placementSequence) {
	const normalized = placementSequence
		.map((p) => `${p.slot_id}<${p.part_id}`)
		.join("|")
	return crypto.createHash("sha1").update(normalized).digest("hex").slice(0, 16)
}

/**
 * Strategy change = a *materially different* assembly approach, not a retry.
 * Material difference is defined as: the ordered opening moves differ, OR more
 * than a third of the placements differ from the previous attempt.
 */
function isStrategyChange(previousSequence, currentSequence, openingDepth = 3) {
	if (!previousSequence || previousSequence.length === 0) return false

	const prevOpen = previousSequence.slice(0, openingDepth).map(k)
	const currOpen = currentSequence.slice(0, openingDepth).map(k)
	if (prevOpen.join(",") !== currOpen.join(",")) return true

	const prevMap = new Map(previousSequence.map((p) => [p.slot_id, p.part_id]))
	let differing = 0
	for (const p of currentSequence) {
		if (prevMap.get(p.slot_id) !== p.part_id) differing++
	}
	const denom = Math.max(currentSequence.length, previousSequence.length, 1)
	return differing / denom > 1 / 3

	function k(p) {
		return `${p.slot_id}<${p.part_id}`
	}
}

module.exports = { computeMethodSignature, isStrategyChange }
