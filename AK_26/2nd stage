// ADAPTER: point this at your existing db helper from Stage 1.
const db = require("../../db")

const STAGE_KEY = "glitched_workshop"

/**
 * Server-side only. Nothing computed here is ever returned to a participant.
 * Produces descriptive metrics, not a single labeled score, and never a
 * diagnostic flag.
 */
async function scoreStage2(sessionId) {
	// Step 2 of the hidden scoring process: all three blocks must have an outcome.
	const blocks = await db.all(
		`SELECT block_number, outcome, status FROM workshop_block_state
		 WHERE session_id = ? ORDER BY block_number`,
		[sessionId]
	)
	const complete = [1, 2, 3].every((n) => {
		const b = blocks.find((x) => x.block_number === n)
		return b && b.status === "complete" && b.outcome
	})
	if (!complete) {
		const err = new Error("Stage 2 cannot be scored: not all blocks have a recorded outcome.")
		err.code = "STAGE2_INCOMPLETE"
		throw err
	}

	const attempts = await db.all(
		`SELECT * FROM workshop_attempts WHERE session_id = ? ORDER BY block_number, recorded_at`,
		[sessionId]
	)
	const ratings = await db.all(
		`SELECT timing, value FROM frustration_ratings WHERE session_id = ?`,
		[sessionId]
	)

	const pre = ratings.find((r) => r.timing === "pre")
	const post = ratings.find((r) => r.timing === "post")

	const perBlock = [1, 2, 3].map((n) => {
		const rows = attempts.filter((a) => a.block_number === n)
		const signatures = rows.map((r) => r.method_signature)
		return {
			block_number: n,
			valid_attempts: rows.length,
			time_persisted_ms: sum(rows.map((r) => r.time_spent_ms)),
			strategy_change_count: rows.filter((r) => r.strategy_change === 1).length,
			distinct_method_count: new Set(signatures).size,
			clue_requests: rows.filter((r) => r.clue_requested === 1).length,
			clue_points_spent: sum(rows.map((r) => r.clue_cost)),
			errors_total: sum(rows.map((r) => r.errors_count)),
			break_taken: rows.some((r) => r.outcome === "break_taken"),
			skipped: rows.some((r) => r.outcome === "skipped"),
			ended_session: rows.some((r) => r.outcome === "ended_session"),
			outcome: blocks.find((b) => b.block_number === n).outcome,
		}
	})

	const reactionAfterFailure = attempts
		.map((a) => a.reaction_time_after_prior_failure_ms)
		.filter((v) => typeof v === "number" && v > 0)

	const firstHalf = reactionAfterFailure.slice(0, Math.ceil(reactionAfterFailure.length / 2))
	const secondHalf = reactionAfterFailure.slice(Math.ceil(reactionAfterFailure.length / 2))

	const metrics = {
		total_persistence_time_ms: sum(perBlock.map((b) => b.time_persisted_ms)),
		strategy_change_count: sum(perBlock.map((b) => b.strategy_change_count)),
		clue_requests: sum(perBlock.map((b) => b.clue_requests)),
		break_choice_blocks: perBlock.filter((b) => b.break_taken).map((b) => b.block_number),
		skip_choice_blocks: perBlock.filter((b) => b.skipped).map((b) => b.block_number),
		ended_session_at_block:
			(perBlock.find((b) => b.ended_session) || {}).block_number || null,
		frustration_rating_pre: pre ? pre.value : null,
		frustration_rating_post: post ? post.value : null,
		// post - pre
		frustration_delta: pre && post ? post.value - pre.value : null,
		reaction_time_after_failure_mean_ms: mean(reactionAfterFailure),
		reaction_time_after_failure_change_ms:
			firstHalf.length && secondHalf.length ? mean(secondHalf) - mean(firstHalf) : null,
		per_block: perBlock,
		// Descriptive only. Persistence is NOT treated as universally good:
		// repeating one unchanged method at length is recorded as low flexibility,
		// not as superior regulation, and carries no valence.
		unchanged_method_repetition: perBlock.map((b) => ({
			block_number: b.block_number,
			repeated_same_method: b.valid_attempts > 1 && b.distinct_method_count === 1,
			attempts: b.valid_attempts,
		})),
		interpretation_note:
			"Descriptive metrics only. No single composite score, ranking, or diagnostic label is produced.",
	}

	await db.run(
		`INSERT INTO stage_summaries (session_id, stage_key, metrics_json, computed_at)
		 VALUES (?, ?, ?, datetime('now'))
		 ON CONFLICT (session_id, stage_key)
		 DO UPDATE SET metrics_json = excluded.metrics_json, computed_at = excluded.computed_at`,
		[sessionId, STAGE_KEY, JSON.stringify(metrics)]
	)

	return metrics // consumed by the researcher backend only
}

const sum = (a) => a.reduce((x, y) => x + (y || 0), 0)
const mean = (a) => (a.length ? sum(a) / a.length : null)

module.exports = { scoreStage2, STAGE_KEY }
"use strict"

const express = require("express")
const crypto = require("crypto")

// ADAPTERS: reuse Stage 1's modules. Do not create parallel security logic.
const db = require("../db")
const { requireParticipantSession, auditLog } = require("../middleware/auth")
const { generatePuzzle, evaluateAttempt, BLOCK_TIERS } = require("../workshop/puzzles")
const { computeMethodSignature, isStrategyChange } = require("../workshop/method-signature")
const { scoreStage2 } = require("../scoring/stage2-glitched-workshop")

const router = express.Router()
const NEXT_STAGE = "ambiguous_handoff"
const BREAK_DURATION_MS = 60000 // fixed-length. No resume-whenever pause.

// Every Stage 2 route sits behind the same Stage 1 session middleware.
router.use(requireParticipantSession)

/**
 * Whitelist gate. Any participant-facing body passes through here, so scoring
 * fields can never leak into a participant response.
 */
const PARTICIPANT_SAFE_KEYS = new Set([
	"stage_complete", "next_stage", "screen", "block_number", "tier",
	"parts", "slots", "constraints", "clue_cost", "feedback_delay_ms",
	"attempt_registered", "block_state", "clue", "points_balance",
	"break_duration_ms", "ok",
])
function sendSafe(res, payload) {
	const out = {}
	for (const [key, value] of Object.entries(payload)) {
		if (!PARTICIPANT_SAFE_KEYS.has(key)) continue
		out[key] = value
	}
	return res.json(out)
}

const store = {
	session: (id) => db.get(`SELECT * FROM sessions WHERE session_id = ?`, [id]),
	blockState: (sid, n) =>
		db.get(`SELECT * FROM workshop_block_state WHERE session_id = ? AND block_number = ?`, [sid, n]),
	lastAttempt: (sid, n) =>
		db.get(
			`SELECT * FROM workshop_attempts WHERE session_id = ? AND block_number = ?
			 ORDER BY recorded_at DESC LIMIT 1`,
			[sid, n]
		),
}

/* ---------- Screen 2 & 6: frustration ratings ---------- */
router.post("/frustration", async (req, res, next) => {
	try {
		const { timing, value, recorded_at } = req.body
		if (!["pre", "post"].includes(timing)) return res.status(400).json({ ok: false })
		const v = Number(value)
		if (!Number.isInteger(v) || v < 1 || v > 5) return res.status(400).json({ ok: false })

		await db.run(
			`INSERT INTO frustration_ratings (rating_id, session_id, timing, value, recorded_at)
			 VALUES (?, ?, ?, ?, COALESCE(?, datetime('now')))
			 ON CONFLICT (session_id, timing) DO NOTHING`,
			[crypto.randomUUID(), req.session.session_id, timing, v, recorded_at || null]
		)
		// The rating is never echoed back to the participant.
		return sendSafe(res, { ok: true })
	} catch (e) { next(e) }
})

/* ---------- Screens 3-5: serve the puzzle config for a block ---------- */
router.get("/block/:blockNumber", async (req, res, next) => {
	try {
		const n = Number(req.params.blockNumber)
		if (![1, 2, 3].includes(n)) return res.status(400).json({ ok: false })

		const sid = req.session.session_id

		// Blocks are strictly ordered; earlier blocks must be complete.
		for (let prev = 1; prev < n; prev++) {
			const s = await store.blockState(sid, prev)
			if (!s || s.status !== "complete") return res.status(409).json({ ok: false })
		}

		let state = await store.blockState(sid, n)
		if (!state) {
			// generatePuzzle throws rather than emit an unsolvable block.
			const { config, secret } = generatePuzzle(n, `${sid}:stage2`)
			await db.run(
				`INSERT INTO workshop_block_state
				 (session_id, block_number, puzzle_config, puzzle_secret, status, started_at)
				 VALUES (?, ?, ?, ?, 'in_progress', datetime('now'))`,
				[sid, n, JSON.stringify(config), JSON.stringify(secret)]
			)
			state = await store.blockState(sid, n)
		} else if (state.status === "assigned") {
			await db.run(
				`UPDATE workshop_block_state SET status = 'in_progress', started_at = datetime('now')
				 WHERE session_id = ? AND block_number = ?`,
				[sid, n]
			)
		}

		const config = JSON.parse(state.puzzle_config) // never includes the solution
		return sendSafe(res, { ...config, screen: `block_${n}` })
	} catch (e) { next(e) }
})

/* ---------- Attempt submission ---------- */
router.post("/attempt", async (req, res, next) => {
	try {
		const sid = req.session.session_id
		const n = Number(req.body.block_number)
		const {
			placement_sequence = [],
			time_spent_ms = 0,
			reaction_time_after_prior_failure_ms = null,
			clue_requested = false,
			clue_cost = 0,
		} = req.body

		const state = await store.blockState(sid, n)
		if (!state || state.status !== "in_progress") return res.status(409).json({ ok: false })

		const secret = JSON.parse(state.puzzle_secret)
		const placements = {}
		for (const p of placement_sequence) placements[p.slot_id] = p.part_id
		const { solved, errors_count } = evaluateAttempt(secret, placements)

		const prev = await store.lastAttempt(sid, n)
		const prevSequence = prev && prev.placement_sequence_json
			? JSON.parse(prev.placement_sequence_json)
			: (req.body.previous_sequence || null)

		const signature = computeMethodSignature(placement_sequence)
		const strategyChange = prev
			? (prevSequence ? isStrategyChange(prevSequence, placement_sequence) : prev.method_signature !== signature)
			: false

		await db.run(
			`INSERT INTO workshop_attempts (
				attempt_id, session_id, block_number, method_signature, strategy_change,
				clue_requested, clue_cost, errors_count, time_spent_ms, outcome,
				reaction_time_after_prior_failure_ms
			) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
			[
				crypto.randomUUID(), sid, n, signature, strategyChange ? 1 : 0,
				clue_requested ? 1 : 0, Number(clue_cost) || 0, errors_count,
				Number(time_spent_ms) || 0, solved ? "solved" : "failed",
				reaction_time_after_prior_failure_ms,
			]
		)

		if (solved) {
			await db.run(
				`UPDATE workshop_block_state SET status = 'complete', outcome = 'solved',
				 ended_at = datetime('now') WHERE session_id = ? AND block_number = ?`,
				[sid, n]
			)
		}

		// Identical shape for pass and fail during the attempt itself: the client
		// renders the same neutral pulse either way. No score, no accuracy.
		return sendSafe(res, {
			attempt_registered: true,
			block_state: solved ? "complete" : "in_progress",
		})
	} catch (e) { next(e) }
})

/* ---------- Clue request: server-validated cost ---------- */
router.post("/clue", async (req, res, next) => {
	try {
		const sid = req.session.session_id
		const n = Number(req.body.block_number)
		const state = await store.blockState(sid, n)
		if (!state || state.status !== "in_progress") return res.status(409).json({ ok: false })

		const cost = BLOCK_TIERS[n].clueCost // server-defined, never client-supplied
		const session = await store.session(sid)
		if (session.points_balance < cost) {
			// Explained, not silently disabled.
			return res.status(200).json({
				ok: false,
				reason: "Not enough points remaining for a hint. You can keep trying, change your approach, take a short break, or skip.",
				points_balance: session.points_balance,
			})
		}

		const secret = JSON.parse(state.puzzle_secret)
		const used = await db.get(
			`SELECT COUNT(*) AS c FROM workshop_attempts
			 WHERE session_id = ? AND block_number = ? AND clue_requested = 1`,
			[sid, n]
		)
		const clue = secret.clue_ladder[Math.min(used.c, secret.clue_ladder.length - 1)]

		await db.run(
			`UPDATE sessions SET points_balance = points_balance - ? WHERE session_id = ?`,
			[cost, sid]
		)
		const updated = await store.session(sid)

		return sendSafe(res, {
			clue: { text: clue.text, slot_id: clue.slot_id, part_id: clue.part_id },
			clue_cost: cost,
			points_balance: updated.points_balance,
		})
	} catch (e) { next(e) }
})

/* ---------- break / skip / end_session ---------- */
