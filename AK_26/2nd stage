		}

		await db.run(
			`UPDATE workshop_block_state SET status = 'complete', outcome = ?, ended_at = datetime('now')
			 WHERE session_id = ? AND block_number = ?`,
			[action, sid, n]
		)

		if (action === "ended_session") {
			// Remaining blocks are closed out so the stage remains scoreable.
			for (let rest = n + 1; rest <= 3; rest++) {
				const { config, secret } = generatePuzzle(rest, `${sid}:stage2`)
				await db.run(
					`INSERT INTO workshop_block_state
					 (session_id, block_number, puzzle_config, puzzle_secret, status, outcome, ended_at)
					 VALUES (?, ?, ?, ?, 'complete', 'ended_session', datetime('now'))
					 ON CONFLICT (session_id, block_number)
					 DO UPDATE SET status = 'complete', outcome = 'ended_session', ended_at = datetime('now')`,
					[sid, rest, JSON.stringify(config), JSON.stringify(secret)]
				)
			}
		}

		return sendSafe(res, { ok: true })
	} catch (e) { next(e) }
})

/* ---------- Screen 7: stage completion ---------- */
router.post("/complete", async (req, res, next) => {
	try {
		const sid = req.session.session_id
		await scoreStage2(sid) // throws STAGE2_INCOMPLETE if a block outcome is missing
		await db.run(
			`UPDATE sessions SET current_stage = ? WHERE session_id = ?`,
			[NEXT_STAGE, sid]
		)
		auditLog({ session_id: sid, event: "stage2_complete" })

		// Exactly this shape. Nothing else.
		return res.json({ stage_complete: true, next_stage: NEXT_STAGE })
	} catch (e) {
		if (e.code === "STAGE2_INCOMPLETE") return res.status(409).json({ ok: false })
		next(e)
	}
})

